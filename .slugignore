# Heroku Slug Size Optimization - Skip unnecessary files

# Node.js and frontend (if deploying backend only)
dashboard/
node_modules/
*.next
npm-debug.log

# Development & Testing
test_venv/
backend/test_venv/
backend/tests/
backend/lifecycle/
venv/
env/
.venv/

# Documentation
README.md
*.md
docs/

# Build artifacts & cache
dist/
build/
*.egg-info/
__pycache__/
.pytest_cache/
*.log

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git
.gitattributes
.gitignore

# Docker (we run in Heroku, not Docker)
Dockerfile.backup
docker-compose.yml

# CI/CD
.github/
.do/
.do-app.yaml

# Development scripts
deploy.bat
deploy.sh
start.sh
fix_*.py
verify_*.py
test_*.py
seed_*.py
migrate_*.py
train_*.py
add_*.py
update_*.py
init_*.py

# Temporary files
*.cache
tmp/
temp/

