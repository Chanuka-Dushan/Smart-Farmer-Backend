# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./smart_farmer.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@host:port/database_name

# JWT Secret Key (Generate a secure random key for production)
SECRET_KEY=your-secret-key-here-change-in-production

# Server Port
PORT=8080

# CORS Origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Firebase Cloud Messaging (FCM)
# Get this from Firebase Console -> Project Settings -> Cloud Messaging -> Server Key
FIREBASE_SERVER_KEY=your-firebase-server-key-here
FIREBASE_PROJECT_ID=your-firebase-project-id

# AI/ML API Keys (NEVER commit actual keys!)
GROK_API_KEY=your-grok-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
WEATHER_API_KEY=your-openweather-api-key-here

# ML Model Configuration
MODEL_VERSION=v1.0
MODEL_PATH=models/smart_farmer_vision_v1.0.h5
MIN_PREDICTION_CONFIDENCE=0.7
DISABLE_TENSORFLOW=false

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_PREDICTION_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# DigitalOcean Spaces
SPACES_KEY=your-spaces-key
SPACES_SECRET=your-spaces-secret
SPACES_REGION=nyc3
SPACES_BUCKET=your-bucket-name
